# LYRR Platform - Environment Configuration
# 
# Copy this file to .env and update with your values

# Application
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=your-secret-key-change-in-production

# Database
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lyrr

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Elasticsearch (optional, for search)
ELASTICSEARCH_URL=http://localhost:9200

# AWS / S3 / MinIO Configuration
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=lyrr-books
S3_REGION=us-east-1

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000"]

# API Keys (optional - for AI features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Monitoring (optional)
SENTRY_DSN=
PROMETHEUS_MULTIPROC_DIR=/tmp

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@lyrr.app

# Payments (FRS §10)
# sandbox = checkout flow works fully offline (card auto-settles, OTP returned)
# live    = requires gateway provider wiring in backend/app/services/payments.py
PAYMENT_MODE=sandbox
PAYMENT_CURRENCY=XAF
DEFAULT_BOOK_PRICE=500

# Verification (FRS §4)
# sandbox = OTP returned in API responses as sandbox_otp for local testing
# live    = OTP delivered via email/SMS, never returned in responses
VERIFICATION_MODE=sandbox

# Content protection (FRS §14)
# Demo mode: MEDIA_AUTH_ENABLED=false + BYPASS_LIBRARY_PERMISSIONS=true
# Production: flip both to enforce purchase/subscription on audio streaming
MEDIA_AUTH_ENABLED=false
BYPASS_LIBRARY_PERMISSIONS=true
