# LYRR Platform - Environment Configuration
# 
# Copy this file to .env and update with your values

# Application
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=your-secret-key-change-in-production

# Database
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lyrr

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Elasticsearch (optional, for search)
ELASTICSEARCH_URL=http://localhost:9200

# AWS / S3 / MinIO Configuration
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=lyrr-books
S3_REGION=us-east-1

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8000"]

# API Keys (optional - for AI features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Monitoring (optional)
SENTRY_DSN=
PROMETHEUS_MULTIPROC_DIR=/tmp

# Email (required when VERIFICATION_MODE=live, for OTP + password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@lyrr.app
SMTP_FROM_NAME=LYRR

# SMS (required when VERIFICATION_MODE=live, for phone OTP)
# Generic HTTP gateway: POST {"to","message","sender_id"} with Bearer auth.
# Compatible with Twilio Functions/Africa's Talking/local SMS aggregators
# behind a thin adapter.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=LYRR

# Password reset link target (web portal or a deep-link handler in the app)
FRONTEND_URL=http://localhost:8080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# This API's own public HTTPS URL - required in production for gateway
# callbacks (Orange Money's notif_url posts here). Must be reachable from
# the internet, not just your LAN.
PUBLIC_API_URL=http://localhost:8000

# Social login (FRS §4) - leave blank to disable a provider (returns 401)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=

# Payments (FRS §10)
# sandbox = checkout flow works fully offline (card auto-settles, OTP returned)
# live    = calls the real gateways below (backend/app/services/payments.py)
PAYMENT_MODE=sandbox
PAYMENT_CURRENCY=XAF
DEFAULT_BOOK_PRICE=500

# Card payments (Stripe) - required when PAYMENT_MODE=live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Orange Money Web Payment API - required when PAYMENT_MODE=live
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_API_BASE=https://api.orange.com

# MTN Mobile Money Collection API - required when PAYMENT_MODE=live
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_API_BASE=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENV=sandbox

# Verification (FRS §4)
# sandbox = OTP returned in API responses as sandbox_otp for local testing
# live    = OTP delivered via email/SMS (see SMTP_*/SMS_* above), never returned
VERIFICATION_MODE=sandbox

# Content protection (FRS §14) - secure by default.
# Demo/sandbox override: set MEDIA_AUTH_ENABLED=false and
# BYPASS_LIBRARY_PERMISSIONS=true to let anyone browse the full catalog
# without a purchase/subscription (useful for client demos only).
MEDIA_AUTH_ENABLED=true
BYPASS_LIBRARY_PERMISSIONS=false
