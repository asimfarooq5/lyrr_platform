# LYRR Platform Environment Configuration
# 
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================
APP_NAME=LYRR Platform
DEBUG=false
ENVIRONMENT=production

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lyrr
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Elasticsearch Configuration
# ============================================
ELASTICSEARCH_URL=http://localhost:9200

# ============================================
# Security Configuration
# ============================================
# Generate a strong secret key: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key for sensitive data (32 characters)
ENCRYPTION_KEY=your-32-character-encryption-key
DRM_KEY_ROTATION_HOURS=24

# ============================================
# AWS / S3 Configuration
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=lyrr-media
# For MinIO or other S3-compatible services
S3_ENDPOINT=http://localhost:9000

# ============================================
# AI Service API Keys
# ============================================
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ============================================
# OAuth Configuration
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://lyrr.app"]

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# Media Configuration
# ============================================
MAX_UPLOAD_SIZE_MB=500

# ============================================
# Monitoring
# ============================================
SENTRY_DSN=your-sentry-dsn
GRAFANA_PASSWORD=admin

# ============================================
# Flutter App Configuration
# ============================================
API_BASE_URL=http://localhost:8000/api/v1
