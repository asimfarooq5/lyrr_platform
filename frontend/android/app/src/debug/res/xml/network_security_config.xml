<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  Overrides src/main/res/xml/network_security_config.xml so a debug build can
  talk to a local dev backend over plain HTTP (e.g. http://192.168.0.228:8000
  or http://127.0.0.1:8000 through `adb reverse`). Release builds keep the
  strict HTTPS-only policy from the main source set.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
